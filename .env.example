# Vercel AI Gateway (pick one auth method)
# Option 1 (recommended): run `vercel link && vercel env pull` — auto-generates VERCEL_OIDC_TOKEN
# Option 2: set AI_GATEWAY_API_KEY manually (requires rotation)
AI_GATEWAY_API_KEY=

# Cron security
CRON_SECRET=your-random-secret-here

# Beauty Shorts / Seedance provider
PIAPI_API_KEY=
PIAPI_BASE_URL=https://api.piapi.ai
PIAPI_SEEDANCE_MODEL=seedance-2.0-fast
